# === OpenClaw Gateway ===
OPENCLAW_GATEWAY_TOKEN=              # already exists in your config, copy from openclaw.json
OPENCLAW_HOOKS_TOKEN=                # dedicated token for incoming webhooks (WhatsApp relay etc.), do NOT reuse gateway token
OPENCLAW_GATEWAY_URL=                # e.g. http://<your-hostname>.tail3450cf.ts.net:18789

# === WhatsApp (via wacli, through OpenClaw) ===
WA_RECIPIENT_PHONE=                  # your number, e.g. +614xxxxxxxx

# === Vultr ===
VULTR_API_KEY=                       # Vultr dashboard -> Account -> API

# === Hostinger ===
HOSTINGER_API_KEY=                   # Hostinger dashboard -> API section (confirm this exists on your plan)
# No per-domain vars: ALL domains in the account are enumerated at runtime via
# GET /api/domains/v1/portfolio (base https://developers.hostinger.com) and each one
# is checked for expiration — don't hardcode domain names anywhere.

# === DomaiNesia ===
# No customer-facing API or MCP server (their REST API is reseller-only: domain
# search/register/transfer). Monitoring goes through cPanel per hosting account —
# SSH creds live in instances.json like every other cPanel instance, nothing here.

# === Per-instance SSH (Vultr CPU/RAM/disk checks, cPanel checks on any instance) ===
# NOT configured here — hosts/IPs come dynamically from each provider's API list call,
# and per-instance SSH credentials (user, port, key path) live in instances.json
# (gitignored — copy instances.example.json and fill in real values).

# === Thresholds (used by alert logic, not secrets, but centralized here for easy tuning) ===
THRESHOLD_CPU_PERCENT=90
THRESHOLD_DISK_PERCENT=90
THRESHOLD_RAM_PERCENT=90
THRESHOLD_EXPIRY_DAYS_TIER1=30
THRESHOLD_EXPIRY_DAYS_TIER2=14
THRESHOLD_EXPIRY_DAYS_TIER3=7
