# === OpenClaw Gateway ===
OPENCLAW_GATEWAY_TOKEN=              # already exists in your config, copy from openclaw.json
OPENCLAW_HOOKS_TOKEN=                # dedicated token for n8n <-> OpenClaw, do NOT reuse gateway token
OPENCLAW_GATEWAY_URL=http://mac-mini-alandani.tail3450cf.ts.net:18789

# === WhatsApp (via wacli, through OpenClaw) ===
WA_RECIPIENT_PHONE=                  # your number, e.g. +61411600896

# === Vultr ===
VULTR_API_KEY=                       # Vultr dashboard -> Account -> API

# === Hostinger ===
HOSTINGER_API_KEY=                    # Hostinger dashboard -> API section (confirm this exists on your plan)
HOSTINGER_DOMAIN=                    # the domain to check expiration for

# === Per-instance SSH (Vultr CPU/RAM/disk checks, cPanel checks on any instance) ===
# NOT configured here — hosts/IPs come dynamically from each provider's API list call,
# and per-instance SSH credentials (user, port, key path) live in instances.json
# (gitignored — copy instances.example.json and fill in real values).

# === n8n ===
N8N_BASE_URL=                        # e.g. https://n8n.yourdomain.com
N8N_API_KEY=                         # n8n Settings -> API, if using n8n API to manage workflows programmatically

# === Thresholds (used by workflow logic, not secrets, but centralized here for easy tuning) ===
THRESHOLD_CPU_PERCENT=90
THRESHOLD_DISK_PERCENT=90
THRESHOLD_RAM_PERCENT=90
THRESHOLD_EXPIRY_DAYS_TIER1=30
THRESHOLD_EXPIRY_DAYS_TIER2=14
THRESHOLD_EXPIRY_DAYS_TIER3=7
